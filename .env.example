# Copy this to .env (or just run ./setup.sh, which does it for you) and adjust paths
# if you want something other than the defaults below.

# All active data lives under one consolidated directory, __HOME__/garmin-dev/, rather
# than scattered across several unrelated paths (an earlier iteration of this repo did
# that and it got confusing fast).

# Shared SDK/device data - both containers bind-mount this to $HOME/.Garmin/ConnectIQ
# (a path Garmin's tooling hardcodes and isn't configurable - see the Dockerfiles).
# If you've already got a natively-installed SDK Manager (outside Docker), its data
# lives at ~/.Garmin/ConnectIQ by that same convention - point this at it instead of a
# fresh empty dir if you want to reuse it.
CONNECTIQ_DATA_DIR=__HOME__/garmin-dev/ConnectIQ

# Where your Monkey C projects live, mounted into the Theia container's workspace.
WORKSPACES_DIR=__HOME__/garmin-dev/workspaces

# Theia's own settings/recent-workspaces/plugin-cache, persisted across container rebuilds.
THEIA_CONFIG_DIR=__HOME__/garmin-dev/theia-ide

# Must match your host user so bind-mounted files aren't owned by the wrong uid/gid.
HOST_UID=1000
HOST_GID=1000

# X11 display to forward GUI windows (sdkmanager, and the simulator launched by Theia's
# Monkey C debugger) to. :0 is the common default for XWayland on Wayland/GNOME too.
DISPLAY=:0
